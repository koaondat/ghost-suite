# Ghost — Environment Variables (root / shared)
# ===============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# Keep this file free of real secrets — placeholder values only.

# ── Shared API (api.py) ────────────────────────────────────────
# Port the Ghost shared Python API listens on.
GHOST_API_PORT=5056

# HMAC signing secret for license key generation and validation.
# Must match across api.py, license_delivery.py, and the desktop app.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER expose or log this value.
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Full URL of the Ghost shared API.
# In production, replace with your deployed API URL (no trailing slash).
# The Discord bot and web server both read this value.
GHOST_API_URL=https://api.yourdomain.com

# Admin API key — used by the Discord bot, desktop panel, and CI
# scripts to authenticate against admin-only endpoints.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER expose in client-side code or logs.
GHOST_ADMIN_API_KEY=replace_with_a_strong_64_hex_char_secret

# JWT signing secret — used to sign customer session tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
# NEVER expose this value.
GHOST_JWT_SECRET=replace_with_a_strong_96_hex_char_jwt_secret

# JWT session lifetime in seconds (default 7 days)
GHOST_JWT_TTL_SECS=604800

# Comma-separated list of allowed CORS origins.
# Set to your exact production domain in production — never use * in prod.
GHOST_ALLOWED_ORIGINS=https://yourdomain.com

# ── CDN / Download ─────────────────────────────────────────────
# Secret used to sign short-lived download tokens. Never returned to clients.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_CDN_SECRET=replace_with_cdn_signing_secret

# Latest release metadata shown to customers
GHOST_LATEST_VERSION=v2.4.1
GHOST_RELEASE_DATE=2025-07-01

# ── Discord bot ────────────────────────────────────────────────
# Bot token from the Discord Developer Portal — NEVER expose publicly
DISCORD_TOKEN=your_discord_bot_token_here

# Guild (server) ID — leave blank (or 0) for global command sync
GUILD_ID=0

# Comma-separated Discord role IDs that grant admin access to bot commands
ADMIN_ROLE_IDS=

# Comma-separated Discord user IDs that always have admin access
ADMIN_USER_IDS=

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── Web / Node server ──────────────────────────────────────────
# Public base URL of the web server (no trailing slash).
# Used to build Stripe success / cancel redirect URLs.
BASE_URL=https://yourdomain.com

# Port the Node.js web server listens on
PORT=3000

# ── Delivery backend (license_delivery.py) ─────────────────────
GHOST_DELIVERY_PORT=5055
GHOST_DELIVERY_URL=http://localhost:5055

# Allowed CORS origin for the license delivery server (license_delivery.py).
# Set to your web server's exact origin in production — never use * in prod.
GHOST_DELIVERY_ALLOWED_ORIGIN=https://yourdomain.com
