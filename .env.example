# Ghost — Environment Variables (root / shared)
# ===============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# Keep this file free of real secrets — placeholder values only.

# ── Shared API (api.py) ────────────────────────────────────────
# Port the Ghost shared Python API listens on.
GHOST_API_PORT=5056

# HMAC signing secret for license key generation and validation.
# Must match across api.py, license_delivery.py, and the desktop app.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER expose or log this value.
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Full URL of the Ghost shared API.
# In production, replace with your deployed API URL (no trailing slash).
# The Discord bot and web server both read this value.
GHOST_API_URL=https://api.yourdomain.com

# Admin API key — used by the Discord bot, desktop panel, and CI
# scripts to authenticate against admin-only endpoints.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER expose in client-side code or logs.
GHOST_ADMIN_API_KEY=replace_with_a_strong_64_hex_char_secret

# JWT signing secret — used to sign customer session tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
# NEVER expose this value.
GHOST_JWT_SECRET=replace_with_a_strong_96_hex_char_jwt_secret

# JWT session lifetime in seconds (default 7 days)
GHOST_JWT_TTL_SECS=604800

# Comma-separated list of allowed CORS origins.
# Set to your exact production domain in production — never use * in prod.
GHOST_ALLOWED_ORIGINS=https://yourdomain.com

# ── CDN / Download ─────────────────────────────────────────────
# Secret used to sign short-lived download tokens. Never returned to clients.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_CDN_SECRET=replace_with_cdn_signing_secret

# Absolute path to the downloadable application binary / archive on the server.
# Read by GET /api/order/:orderId/download to build the signed download response.
# Example: /srv/ghost/releases/GhostSetup-v2.4.1.zip
# This is NEVER interpolated from user input — only the path in this var is served.
GHOST_DOWNLOAD_PATH=/srv/ghost/releases/GhostSetup-latest.zip

# Latest release metadata shown to customers
GHOST_LATEST_VERSION=v2.4.1
GHOST_RELEASE_DATE=2025-07-01

# ── Object storage for release binaries (Cloudflare R2 / AWS S3) ───────────
#
# REQUIRED to enable the direct-upload flow in the admin Release Manager.
# Without these vars, GET /api/admin/releases/upload-url returns HTTP 503,
# and the admin panel will show:
#   "Storage upload failed: Object storage is not configured on this server…"
#
# The EXE upload path (browser → R2 → finalize metadata to API) completely
# bypasses the Vercel / Express request-body limit. The 10.9 MB binary is PUT
# DIRECTLY from the browser to R2 using the presigned URL returned here.
# Only tiny JSON payloads ever reach the Vercel / Flask servers.
#
# ── Cloudflare R2 setup ──────────────────────────────────────────────────────
# 1. Create a bucket at https://dash.cloudflare.com → R2
# 2. Create an API token with "Object Read & Write" on that bucket
# 3. Enable "Public access" on the bucket (or set up a custom domain)
# 4. Add a CORS policy to the bucket that allows PUT from your admin domain:
#       [{"AllowedOrigins":["https://your-admin-domain.com"],
#         "AllowedMethods":["PUT"],
#         "AllowedHeaders":["Content-Type"],
#         "MaxAgeSeconds":3600}]
# 5. Fill in the four variables below.
#
# ── AWS S3 setup ─────────────────────────────────────────────────────────────
# Leave GHOST_STORAGE_ENDPOINT blank; set GHOST_STORAGE_REGION to your region.
# Set a bucket CORS policy to allow PUT from your admin origin (same as above).
#
# Bucket name (e.g. "ghost-releases")
GHOST_STORAGE_BUCKET=ghost-releases

# R2 endpoint URL — from R2 bucket → Settings → S3 API (omit for AWS S3)
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
GHOST_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 / AWS Access Key ID
GHOST_STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id

# R2 / AWS Secret Access Key (NEVER commit to git)
GHOST_STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key

# Region — use "auto" for R2; your bucket region for AWS S3 (e.g. "us-east-1")
GHOST_STORAGE_REGION=auto

# Public CDN base URL for the bucket (no trailing slash).
# Downloads from the desktop app and /download/latest redirects point here.
# For R2 with public access: https://<bucket>.<account>.r2.dev
# For R2 with a custom domain: https://cdn.yourdomain.com
# For AWS S3: leave blank — the default https://<bucket>.s3.<region>.amazonaws.com is used.
GHOST_STORAGE_CDN_BASE=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Discord OAuth2 (account linking) ──────────────────────────
# Used by the website to link customer Phantom accounts to Discord.
# Get these from: https://discord.com/developers/applications
#   → Your App → OAuth2 → Client ID / Client Secret
#
# DISCORD_CLIENT_SECRET must NEVER be committed to git, logged, or returned
# to the browser.  It is used only in the server-side token exchange.
#
# DISCORD_REDIRECT_URI must be added to "Redirects" in the Discord Dev Portal
# under OAuth2 → General.  Must match exactly (including https/http and path).
# Example: https://yourdomain.com/auth/discord/callback
#
# OAuth scopes used: identify  guilds.join
#   • identify     — fetch the user's Discord ID and username
#   • guilds.join  — add the user to DISCORD_GUILD_ID server-side (no extra prompt)
#
DISCORD_CLIENT_ID=your_discord_oauth_client_id_here
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret_here
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# ── Discord Guild / Server integration ────────────────────────
# The numeric ID of your Discord server (right-click server → Copy Server ID).
# Used server-side to add customers to the server via guilds.join OAuth scope.
# Also used by the bot for startup validation and role assignment.
DISCORD_GUILD_ID=your_discord_server_id_here

# ── Discord bot ────────────────────────────────────────────────
# Bot token from the Discord Developer Portal — NEVER expose publicly.
# Used server-side (web server + bot.py) for guild join and role assignment.
# Must be the SAME bot that is installed in DISCORD_GUILD_ID.
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Legacy alias — bot.py reads DISCORD_TOKEN; set to the same value as DISCORD_BOT_TOKEN
DISCORD_TOKEN=your_discord_bot_token_here

# Guild (server) ID — leave blank (or 0) for global command sync
# Set to the same value as DISCORD_GUILD_ID above.
GUILD_ID=0

# ── Bot role-based permission system ──────────────────────────
# Each variable is a single Discord role ID (numeric snowflake).
# Get them from Discord: Server Settings → Roles → right-click → Copy Role ID
# The bot validates these on startup and logs an error if any ID is missing
# from the guild.  Leave blank to disable that permission tier.

# Verified buyer role — assigned automatically after a confirmed purchase.
# The bot must have Manage Roles and its role must be ABOVE this role in the hierarchy.
CUSTOMER_ROLE_ID=

# Can use /genkey and /bulkdelete
KEY_GENERATOR_ROLE_ID=

# Full license management: generate + lookup + revoke + extend + reset
KEY_MANAGER_ROLE_ID=

# Read-only support commands: /keyinfo /userinfo /listkeys
# Cannot generate or revoke keys.
SUPPORT_ROLE_ID=

# Full access to every bot command, including /permissions
BOT_ADMIN_ROLE_ID=

# Legacy: comma-separated role IDs treated as Bot Admin (backward compat)
ADMIN_ROLE_IDS=

# Comma-separated Discord user IDs that always have full bot access (emergency override)
ADMIN_USER_IDS=

# ── PayPal ─────────────────────────────────────────────────────
# Client ID — injected into checkout.html at request time; safe for frontend.
PAYPAL_CLIENT_ID=your_paypal_client_id_here
# Client Secret — NEVER expose in frontend code or commit to git.
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# 'sandbox' for testing, 'live' only after sandbox is verified working.
PAYPAL_ENVIRONMENT=sandbox

# ── Web / Node server ──────────────────────────────────────────
# Public base URL of the web server (no trailing slash).
BASE_URL=https://yourdomain.com

# Port the Node.js web server listens on
PORT=3000

# SHA-256 hex digest of the /admin panel password (never the plain-text value).
# Generate: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# Login URL: https://yourdomain.com/admin  (password-only, no username prompt)
ADMIN_PANEL_PASSWORD_HASH=replace_with_sha256_hex_of_your_admin_password

# Secret used to sign the HttpOnly admin session cookie.
# REQUIRED for Vercel (stateless serverless) — without this every cold-start
# regenerates a random secret and invalidates all active sessions (→ 401).
# Generate: node -e "const c=require('crypto');console.log(c.randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_a_strong_96_hex_char_jwt_secret

# ── Admin API key (server-side automation / bot integration) ───────────────
# The Discord bot sends this in TWO headers on every admin API call:
#   Authorization: Bearer <GHOST_ADMIN_API_KEY>   (primary / standard)
#   X-Admin-Key:   <GHOST_ADMIN_API_KEY>           (legacy fallback)
# The backend (server.js and api.py) accepts EITHER header.
# This key must be IDENTICAL on the bot .env AND the Vercel environment variables.
# Separate from the human admin-panel password — used by bots, CI scripts, etc.
# NEVER place in browser JS, never return through public APIs, never log it.
# Generate: node -e "const c=require('crypto');console.log('ghost_admin_'+c.randomBytes(32).toString('hex'))"
GHOST_ADMIN_API_KEY=ghost_admin_replace_with_long_random_value

# ── Delivery backend (license_delivery.py) ─────────────────────
GHOST_DELIVERY_PORT=5055
# LOCAL DEV ONLY: http://localhost:5055
# PRODUCTION: must be a real public URL, e.g. https://delivery.yourdomain.com
# NEVER use localhost in production — Vercel cannot reach localhost.
GHOST_DELIVERY_URL=https://delivery.yourdomain.com

# Allowed CORS origin for the license delivery server (license_delivery.py).
# Set to your web server's exact origin in production — never use * in prod.
GHOST_DELIVERY_ALLOWED_ORIGIN=https://yourdomain.com

# ── Upstash Redis — persistent order storage ─────────────────────────────
# REQUIRED for Vercel + any serverless/ephemeral deployment.
# Vercel serverless functions have an ephemeral filesystem — orders.json
# written in one function invocation is NOT visible to the next invocation.
#
# Set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN on:
#   1. The Vercel project (for the Node server)
#   2. The Python delivery server host (Railway/Render/Fly.io/VPS)
# Both must point to the SAME Upstash database.
#
# Create a free database: https://console.upstash.com
# If not set, license_delivery.py falls back to orders.json (local dev only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Discord bot event notification channels ────────────────────────────────
# Optional: set these to post automated notifications in staff-only channels.

# Post a purchase notification embed when a verified purchase is completed and
# the Customer role is assigned.  Leave blank to disable.
PURCHASE_LOG_CHANNEL_ID=

# Post a license event embed for: key generated, key revoked, HWID reset,
# bulk keys generated, role sync repaired.  Leave blank to disable.
LICENSE_LOG_CHANNEL_ID=

# ── Bulk generation limit ──────────────────────────────────────────────────
# Maximum number of keys allowed in a single /bulkgen request.
# Discord input is also validated against this server-side limit.
BULKGEN_MAX=50
