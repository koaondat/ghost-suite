{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "login.html",
          "register.html",
          "dashboard.html",
          "pricing.html",
          "checkout.html",
          "admin.html",
          "assets/**",
          "public/**",
          "api/paypal.js",
          "api/checkout.js",
          "api/stripe_webhook.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/health",
      "dest": "server.js"
    },
    {
      "src": "/status",
      "dest": "server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
