# Ghost — Web / Node Server Environment Variables
# =================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Stripe ────────────────────────────────────────────────────
# Publishable key — safe to expose in frontend config
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Secret key — NEVER expose in frontend code or commit to git
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Webhook signing secret — obtained from Stripe Dashboard → Webhooks
# or via `stripe listen --print-secret` for local development
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── Application ───────────────────────────────────────────────
# Public base URL of this server (no trailing slash)
# Used to build Stripe success/cancel redirect URLs
BASE_URL=https://yourdomain.com

# Port the Node.js web server listens on
PORT=3000

# ── Ghost shared Python API ───────────────────────────────────
# Full URL of the deployed Ghost API (api.py).
# In production, set this to your real API URL — do NOT use localhost.
GHOST_API_URL=https://api.yourdomain.com
GHOST_API_PORT=5056

# ── License delivery backend ──────────────────────────────────
GHOST_DELIVERY_URL=http://localhost:5055
GHOST_DELIVERY_PORT=5055

# HMAC secret for license key generation — must match the Python api.py value
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Allowed CORS origin for the license delivery server
GHOST_DELIVERY_ALLOWED_ORIGIN=https://yourdomain.com
