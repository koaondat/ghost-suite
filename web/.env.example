# Ghost — Web / Node Server Environment Variables
# =================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# ── Vercel deployment notes ────────────────────────────────────────────────
# When deploying to Vercel, set ALL variables below via:
#   vercel env add <NAME>
# or through the Vercel dashboard → Project Settings → Environment Variables.
# After adding or changing any variable, redeploy for them to take effect.
# A .env file is NOT used by Vercel at runtime — env vars must be set in the
# Vercel dashboard and a new deployment triggered.
#
# ── Architecture note ──────────────────────────────────────────────────────
# This Node.js server (server.js) CAN run on Vercel as a serverless function.
# However the Python backend (api.py / license_delivery.py) CANNOT run on
# Vercel — it requires a persistent process (Flask/gunicorn).
#
# You MUST deploy the Python backend separately on a platform that supports
# long-running processes, for example:
#   • Railway   https://railway.app
#   • Render    https://render.com
#   • Fly.io    https://fly.io
#   • Any VPS   (DigitalOcean, Hetzner, Linode, etc.)
#
# Then set GHOST_API_URL and GHOST_DELIVERY_URL to the public URLs of those
# deployed services — do NOT use localhost or 127.0.0.1 in production.
# ──────────────────────────────────────────────────────────────────────────

# ── PayPal ────────────────────────────────────────────────────
# Client ID — safe to expose in frontend config (injected into checkout.html)
# Get this from https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Client Secret — NEVER expose in frontend code or commit to git.
# Keep this server-side ONLY.
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# 'sandbox' for testing, 'live' for real payments.
# Do NOT switch to 'live' until a full sandbox purchase succeeds.
PAYPAL_ENVIRONMENT=sandbox

# ── Application ───────────────────────────────────────────────
# Public base URL of this server (no trailing slash)
# On Vercel this is your production domain, e.g. https://ghost.yourdomain.com
BASE_URL=https://yourdomain.com

# Port the Node.js web server listens on (not used on Vercel — Vercel ignores PORT)
PORT=3000

# ── Ghost shared Python API ───────────────────────────────────
# Full URL of the deployed Ghost API (api.py).
# Must be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy api.py on Railway, Render, Fly.io, or a VPS and paste the URL here.
# REQUIRED — registration, login, and license endpoints return 503 without this.
GHOST_API_URL=https://api.yourdomain.com

# ── License delivery backend ──────────────────────────────────
# Full URL of the deployed Ghost license_delivery server (license_delivery.py).
# Must be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy license_delivery.py on the same host as api.py (or separately).
# REQUIRED — checkout will fail to deliver keys without this.
GHOST_DELIVERY_URL=https://delivery.yourdomain.com

# HMAC secret for license key generation — must match the Python api.py value
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Allowed CORS origin for the license delivery server
GHOST_DELIVERY_ALLOWED_ORIGIN=https://yourdomain.com
