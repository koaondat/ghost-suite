# Ghost — Web / Node Server Environment Variables
# =================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# ── Vercel deployment notes ────────────────────────────────────────────────
# When deploying to Vercel, set ALL variables below via:
#   vercel env add <NAME>
# or through the Vercel dashboard → Project Settings → Environment Variables.
# After adding or changing any variable, redeploy for them to take effect.
# A .env file is NOT used by Vercel at runtime — env vars must be set in the
# Vercel dashboard and a new deployment triggered.
#
# ── Architecture: three-service model ─────────────────────────────────────
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Vercel (serverless)              │  External hosted service             │
# │  Node.js — server.js              │  Python — license_delivery.py        │
# │  • PayPal capture                 │  • License key generation (keygen.py)│
# │  • Proxies /api/auth/* etc.       │  • Order record storage (Redis/file) │
# │  • Routes to GHOST_DELIVERY_URL → │← GHOST_DELIVERY_URL                 │
# └─────────────────────────────────────────────────────────────────────────┘
#
# The Python backend (api.py / license_delivery.py) CANNOT run on Vercel —
# it requires a persistent process (Flask/gunicorn).  Deploy it on:
#   • Railway   https://railway.app
#   • Render    https://render.com
#   • Fly.io    https://fly.io
#   • Any VPS   (DigitalOcean, Hetzner, Linode, etc.)
#
# Then set GHOST_API_URL and GHOST_DELIVERY_URL to the public URLs of those
# deployed services — do NOT use localhost or 127.0.0.1 in production.
#
# ── Why the 503 happens ────────────────────────────────────────────────────
# GET /api/order/:orderId returns 503 when:
#   1. GHOST_DELIVERY_URL is not set — the proxy refuses immediately.
#   2. GHOST_DELIVERY_URL points to localhost — unreachable from Vercel.
#   3. The delivery server cannot find the order because orders.json on the
#      local filesystem was never written (Vercel is ephemeral / read-only).
#
# The fix: set GHOST_DELIVERY_URL to a real public URL AND configure the
# delivery server to use Upstash Redis for persistent order storage.
# ──────────────────────────────────────────────────────────────────────────

# ── PayPal ────────────────────────────────────────────────────
# Client ID — safe to expose in frontend config (injected into checkout.html)
# Get this from https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Client Secret — NEVER expose in frontend code or commit to git.
# Keep this server-side ONLY.
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# 'sandbox' for testing, 'live' for real payments.
# Do NOT switch to 'live' until a full sandbox purchase succeeds.
PAYPAL_ENVIRONMENT=sandbox

# Webhook ID from developer.paypal.com → Webhooks → your webhook → Webhook ID
# Required for server-side signature verification of incoming webhook events.
# If not set, webhook signature verification is skipped (sandbox only — set in prod).
PAYPAL_WEBHOOK_ID=

# ── Application ───────────────────────────────────────────────
# Public base URL of this server (no trailing slash)
# On Vercel this is your production domain, e.g. https://ghost.yourdomain.com
BASE_URL=https://yourdomain.com

# Port the Node.js web server listens on (not used on Vercel — Vercel ignores PORT)
PORT=3000

# ── Ghost shared Python API ───────────────────────────────────
# Full URL of the deployed Ghost API (api.py).
# MUST be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy api.py on Railway, Render, Fly.io, or a VPS and paste the URL here.
# REQUIRED — registration, login, and license endpoints return 503 without this.
GHOST_API_URL=https://api.yourdomain.com

# ── License delivery backend ──────────────────────────────────
# Full URL of the deployed Ghost license_delivery server (license_delivery.py).
# MUST be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy license_delivery.py on the same host as api.py (or separately).
# REQUIRED — checkout will fail to deliver keys without this.
# This is the most common cause of delivery_pending and the 503 on /api/order/:orderId.
GHOST_DELIVERY_URL=https://delivery.yourdomain.com

# HMAC secret for license key generation — must match the Python api.py value
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Allowed CORS origin for the license delivery server
GHOST_DELIVERY_ALLOWED_ORIGIN=https://yourdomain.com

# ── Upstash Redis — persistent order storage ──────────────────
# Required for production: Vercel serverless functions have ephemeral
# filesystems.  Orders written to disk during one invocation are gone by
# the next.  Use Upstash Redis as the shared persistent store instead.
#
# Create a free Redis database at https://console.upstash.com
# Then copy the REST URL and token from the database details page.
#
# Set these on BOTH the Vercel project AND the Python delivery server
# (Railway/Render/Fly.io) so both services read from the same store.
#
# If not set, orders fall back to local orders.json (local dev only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Admin panel ────────────────────────────────────────────────
# SHA-256 hex digest of the administrator password for the /admin dashboard.
# NEVER store the plain-text password here — store its SHA-256 hash only.
# Sessions last 4 hours. If not set the /admin panel login returns 503.
#
# !! REQUIRED on Vercel — set this via the Vercel dashboard or CLI:
#      vercel env add ADMIN_PANEL_PASSWORD_HASH
#    Paste the SHA-256 hex string (64 hex chars) as the value.
#
# To generate a hash for a new password, run:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# Then paste the printed hex value below (and into the Vercel env var).
#
# Login URL  : https://yourdomain.com/admin
# Login type : password only (no username field)
#
# Default credentials (CHANGE BEFORE PRODUCTION USE):
#   Password : GhostAdmin#2026!Secure
#   SHA-256  : 95e2755cb7447c8530252bad50de31338155cba576b9bf668dc86a8991e1022e
ADMIN_PANEL_PASSWORD_HASH=95e2755cb7447c8530252bad50de31338155cba576b9bf668dc86a8991e1022e

