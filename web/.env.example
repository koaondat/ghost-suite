# Ghost — Web / Node Server Environment Variables
# =================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# ── Vercel deployment notes ────────────────────────────────────────────────
# When deploying to Vercel, set ALL variables below via:
#   vercel env add <NAME>
# or through the Vercel dashboard → Project Settings → Environment Variables.
# After adding or changing any variable, redeploy for them to take effect.
# A .env file is NOT used by Vercel at runtime — env vars must be set in the
# Vercel dashboard and a new deployment triggered.
#
# ── Architecture: two-service model ───────────────────────────────────────
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  Vercel (serverless)              │  External hosted service             │
# │  Node.js — server.js              │  Python — api.py                     │
# │  • PayPal capture                 │  • License key generation            │
# │  • Admin panel (auth + data)      │  • User auth endpoints               │
# │  • Upstash Redis for admin data   │  • License validation                │
# │  • Proxies /api/auth/* etc.    → │← GHOST_API_URL                      │
# └──────────────────────────────────────────────────────────────────────────┘
#
# The Python backend (api.py) CANNOT run on Vercel — it requires a persistent
# process (Flask/gunicorn).  Deploy it on:
#   • Railway   https://railway.app
#   • Render    https://render.com
#   • Fly.io    https://fly.io
#   • Any VPS   (DigitalOcean, Hetzner, Linode, etc.)
#
# ── Admin panel ────────────────────────────────────────────────────────────
# The admin panel at /admin uses GHOST_ADMIN_API_KEY for login (see below).
# No password hash is needed — the key IS the credential.
# Admin data (inventory, orders, customers) is stored in Upstash Redis.
# ──────────────────────────────────────────────────────────────────────────

# ── PayPal ────────────────────────────────────────────────────
# Client ID — safe to expose in frontend config (injected into checkout.html)
# Get this from https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Client Secret — NEVER expose in frontend code or commit to git.
# Keep this server-side ONLY.
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# 'sandbox' for testing, 'live' for real payments.
# Do NOT switch to 'live' until a full sandbox purchase succeeds.
PAYPAL_ENVIRONMENT=sandbox

# Webhook ID from developer.paypal.com → Webhooks → your webhook → Webhook ID
# Required for server-side signature verification of incoming webhook events.
# If not set, webhook signature verification is skipped (sandbox only — set in prod).
PAYPAL_WEBHOOK_ID=

# ── Application ───────────────────────────────────────────────
# Public base URL of this server (no trailing slash)
# On Vercel this is your production domain, e.g. https://ghost-suite-wp4n.vercel.app
BASE_URL=https://ghost-suite-wp4n.vercel.app

# Port the Node.js web server listens on (not used on Vercel — Vercel ignores PORT)
PORT=3000

# ── Ghost shared Python API ───────────────────────────────────
# Full URL of the deployed Ghost API (api.py).
# MUST be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy api.py on Railway, Render, Fly.io, or a VPS and paste the URL here.
# REQUIRED — registration, login, and license endpoints return 503 without this.
GHOST_API_URL=https://api.yourdomain.com

# ── License delivery backend ──────────────────────────────────
# Full URL of the deployed Ghost license_delivery server (license_delivery.py).
# MUST be a public URL — NEVER localhost or 127.0.0.1 in production.
# Deploy license_delivery.py on the same host as api.py (or separately).
# REQUIRED — checkout will fail to deliver keys without this.
GHOST_DELIVERY_URL=https://delivery.yourdomain.com

# HMAC secret for license key generation — must match the Python api.py value
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GHOST_HMAC_SECRET=replace_with_a_strong_64_hex_char_hmac_secret

# Allowed CORS origin for the license delivery server
GHOST_DELIVERY_ALLOWED_ORIGIN=https://ghost-suite-wp4n.vercel.app

# ── Upstash Redis — persistent admin storage ──────────────────
# REQUIRED for the admin panel to persist inventory, orders, settings, etc.
# Vercel serverless functions have ephemeral filesystems — data written to disk
# during one invocation is gone by the next.
# Upstash Redis provides persistent key-value storage accessible via REST API.
#
# Create a free Redis database at https://console.upstash.com
# Then copy the REST URL and token from the database details page.
#
# Also set these on the Python delivery server (Railway/Render/Fly.io) so both
# services read from the same store.
#
# If not set, admin data endpoints return empty arrays (dev mode only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Release storage (Cloudflare R2 / AWS S3) ──────────────────
#
# Production upload architecture — eliminates HTTP 413 forever:
#   Browser  ──hash──►  API (get presigned URL)
#   Browser  ─────────────────────────────────►  R2/S3  (direct PUT, no proxy)
#   Browser  ──metadata──►  API  (finalize, create release record)
#
# The EXE never passes through Vercel or any API proxy.
# No 4.5 MB limit. No HTTP 413. Works for any file size.
#
# ── Cloudflare R2 (recommended) ─────────────────────────────────
# 1. Create a bucket at dash.cloudflare.com → R2
# 2. Create an API token: "Object Read & Write" scoped to your bucket
# 3. Enable public access or set up a custom domain (GHOST_STORAGE_CDN_BASE)
# 4. Configure CORS on the bucket to allow PUT from your admin origin:
#      Allowed Origins: https://your-domain.vercel.app
#      Allowed Methods: PUT
#      Allowed Headers: Content-Type
#
# R2 Account ID is the hex string in your Cloudflare dashboard URL.
# GHOST_STORAGE_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
GHOST_STORAGE_BUCKET=ghost-releases
GHOST_STORAGE_ENDPOINT=https://YOUR_R2_ACCOUNT_ID.r2.cloudflarestorage.com
GHOST_STORAGE_ACCESS_KEY=your_r2_access_key_id
GHOST_STORAGE_SECRET_KEY=your_r2_secret_access_key
GHOST_STORAGE_REGION=auto
# Public CDN base URL — if you have a custom domain on the R2 bucket:
GHOST_STORAGE_CDN_BASE=https://cdn.yourdomain.com
# If no custom domain, leave empty and the R2 endpoint URL is used.
# GHOST_STORAGE_CDN_BASE=

# ── AWS S3 (alternative) ────────────────────────────────────────
# Leave GHOST_STORAGE_ENDPOINT empty for AWS S3 (uses default AWS resolver).
# GHOST_STORAGE_BUCKET=ghost-releases
# GHOST_STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# GHOST_STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# GHOST_STORAGE_REGION=us-east-1
# GHOST_STORAGE_CDN_BASE=https://ghost-releases.s3.us-east-1.amazonaws.com

# ── Admin panel ────────────────────────────────────────────────
# GHOST_ADMIN_API_KEY is the single credential for accessing /admin.
# The admin enters this key once in the "Admin API Key" field on the login form.
# The server verifies it with timingSafeEqual against this env var.
# On success, a signed HttpOnly session cookie is issued (12-hour TTL).
#
# Security properties:
#   • This key is NEVER returned through any API endpoint.
#   • It is NEVER stored in localStorage, sessionStorage, cookies, or HTML.
#   • The browser never sees the key after the initial POST /api/admin/login.
#   • Admin login is rate-limited: 10 attempts per 15 minutes per IP.
#   • Session cookie: __Host- prefix → Secure, Path=/, no Domain, HttpOnly.
#
# Generate a strong key:
#   node -e "const c=require('crypto');console.log('ghost_admin_'+c.randomBytes(32).toString('hex'))"
#
# Then add to Vercel:
#   vercel env add GHOST_ADMIN_API_KEY
#
# Admin URL: https://ghost-suite-wp4n.vercel.app/admin
GHOST_ADMIN_API_KEY=ghost_admin_replace_with_long_random_value

# ── Admin session secret ────────────────────────────────────────────────────────
# HMAC secret used to sign the stateless admin session cookie (__Host-ghost_admin_session).
# CRITICAL for Vercel: each serverless function invocation may run on a different
# instance. Without a stable secret shared across all instances, the signature from
# one instance is rejected by every other → the 401 "session expired" loop on every
# admin request after login.
# A stable env-var value fixed across all Vercel instances fixes this permanently.
#
# Generate:
#   node -e "const c=require('crypto');console.log(c.randomBytes(64).toString('hex'))"
#
# Add to Vercel:
#   vercel env add ADMIN_SESSION_SECRET
#
# NEVER commit this value to git. NEVER log it. NEVER expose it to the browser.
ADMIN_SESSION_SECRET=replace_with_a_cryptographically_random_128_hex_char_secret

# ── Discord OAuth2 (customer account linking) ─────────────────
# Used by the Node server to link Phantom accounts to Discord via OAuth2.
# Get these from: https://discord.com/developers/applications
#   → Your App → OAuth2 → Client Information
#
# DISCORD_CLIENT_SECRET is server-side ONLY — NEVER log, commit, or return to browser.
# DISCORD_REDIRECT_URI must exactly match a redirect URL added in the Discord Dev Portal.
#   OAuth2 → General → Redirects → Add:  https://yourdomain.com/auth/discord/callback
#
DISCORD_CLIENT_ID=your_discord_oauth_client_id_here
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret_here
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback
